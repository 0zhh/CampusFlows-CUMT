      "id": "RULE-002",
      "subject": "菜鸟自助取件",
      "description": "按取件通知找件，在自助设备扫描快递条码与取件码；可依指南向人工服务处求助。",
      "source_ids": [
        "S01"
      ],
      "type": "student_reported"
    },
    {
      "id": "RULE-003",
      "subject": "顺丰／京东",
      "description": "在桃苑主站内部西侧服务区领取，不按四个菜鸟站任意分配。",
      "source_ids": [
        "S01"
      ],
      "type": "student_reported"
    },
    {
      "id": "RULE-004",
      "subject": "包裹类型",
      "description": "主站接收部分大件与异形件；三辅站主要处理中小件。超大件是否入校需实际协调。",
      "source_ids": [
        "S01"
      ],
      "type": "student_reported"
    },
    {
      "id": "RULE-005",
      "subject": "高峰分流",
      "description": "指南称开学、618、双十一时实际取件站可能与所填地址不同；演示可据此呈现分流设想，不能宣称掌握现行调度算法。",
      "source_ids": [
        "S01"
      ],
      "type": "student_reported"
    },
    {
      "id": "RULE-006",
      "subject": "普通寄件",
      "description": "可在菜鸟下单选择服务点自寄或上门取件；服务点自寄前往桃苑前台。",
      "source_ids": [
        "S01"
      ],
      "type": "student_reported"
    },
    {
      "id": "RULE-007",
      "subject": "顺丰／京东寄件",
      "description": "可提前在相应小程序／APP下单，选择到服务点或上门；课程演示不提交真实订单。",
      "source_ids": [
        "S01"
      ],
      "type": "student_reported"
    },
    {
      "id": "RULE-008",
      "subject": "邮政业务",
      "description": "收发室承担邮件领取；指南所列部分邮寄业务需到校外邮政网点办理，EMS寄件另列上门方式。",
      "source_ids": [
        "S01"
      ],
      "type": "student_reported"
    },
    {
      "id": "RULE-009",
      "subject": "停留时限",
      "description": "未核得正式免费存放天数与超期退回政策；不得将学生经验描述固化为承诺。",
      "source_ids": [
        "S01"
      ],
      "type": "unverified_policy"
    },
    {
      "id": "RULE-010",
      "subject": "竹苑与杏苑",
      "description": "指南明确竹苑无独立菜鸟驿站；本轮未核得杏苑独立快递站。不得按每苑一站自动补造站点。",
